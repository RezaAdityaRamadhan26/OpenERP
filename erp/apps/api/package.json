{
  "name": "@open-erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "test": "bun test"
  },
  "dependencies": {
    "hono": "^4.6.12",
    "zod": "^3.23.8",
    "@open-erp/config": "workspace:*",
    "@open-erp/shared": "workspace:*",
    "@open-erp/db": "workspace:*",
    "@open-erp/organization": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
