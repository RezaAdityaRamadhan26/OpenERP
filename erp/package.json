{
  "name": "open-erp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter @open-erp/api dev",
    "dev:web": "bun run --filter @open-erp/web dev",
    "build": "bun run --filter '*' build",
    "build:api": "bun run --filter @open-erp/api build",
    "build:web": "bun run --filter @open-erp/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "format": "bunx biome format . --write",
    "format:check": "bunx biome format .",
    "test": "bun test",
    "db:generate": "bun run --filter @open-erp/db generate",
    "db:migrate": "bun run --filter @open-erp/db migrate",
    "db:studio": "bun run --filter @open-erp/db studio",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  }
}
